# Canlı/profesyonel kullanım: tarayıcı pencereleri görünmez.
SCRAPER_HEADLESS=true

# Aynı anda kaç ürün detayının taranacağı (öneri: 3, üst sınır: 8).
SCRAPER_WORKERS=3

# Worker görevlerini başlatırken aradaki saniye. Mağazayı zorlamamak için 0.5-1.5.
SCRAPER_REQUEST_DELAY=0.6

# Hatalı ürün için ek deneme sayısı.
SCRAPER_RETRY_COUNT=1
